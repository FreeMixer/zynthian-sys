[Unit]
Description=MOD GUIs from omx-panel for LV2 plugins that ship none
After=local-fs.target
ConditionPathExists=/usr/bin/omx-panel

[Service]
# Runs at boot and after each apt run (etc/apt/apt.conf.d/80omx-modgui-sync).
# The first run scans every plugin without a MOD GUI; later runs only check.
Type=oneshot
Environment=LV2_PATH=#LV2_PATH#
Environment=ZYNTHIAN_CONFIG_DIR=#ZYNTHIAN_CONFIG_DIR#
ExecStart=#ZYNTHIAN_SYS_DIR#/scripts/omx-modgui-sync.sh
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
